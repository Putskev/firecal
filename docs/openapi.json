{
  "openapi": "3.1.0",
  "info": {
    "title": "FireCal API",
    "description": "Harmonized MODIS + VIIRS active fire hotspots (NASA FIRMS). This is a static copy of the documentation: run the backend locally (`uvicorn backend.main:app`) and open /docs to try the endpoints.",
    "version": "2.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/meta": {
      "get": {
        "summary": "Meta",
        "description": "Data span and version, counts per satellite, satellite timeline, harmonization method and\ncalibration table (factor per region with 25-75 % band).",
        "operationId": "meta_api_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/timeseries": {
      "get": {
        "summary": "Timeseries",
        "description": "Per period. Monthly: over the WHOLE data span (medians need history). Daily: start/end (if given) limit\nthe window, which keeps daily requests fast on a long archive.\n\nraw (respects satellites/daynight): modis_n, viirs_n, modis_frp, viirs_frp, raw_n, raw_frp, n_night, n_high\nharmonized (VIIRS level, all satellites): harm_n, harm_n_lo, harm_n_hi, harm_frp, harm_frp_lo, harm_frp_hi,\nmodis_h_n / viirs_h_n (share of harm_n from calibrated MODIS / native VIIRS), modis_cal_n, modis_cal_frp\n(MODIS x factor for every period, also after the VIIRS start).",
        "operationId": "timeseries_api_timeseries_get",
        "parameters": [
          {
            "name": "granularity",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "month",
                "day"
              ],
              "type": "string",
              "default": "month",
              "title": "Granularity"
            }
          },
          {
            "name": "bbox",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "west,south,east,north",
              "title": "Bbox"
            },
            "description": "west,south,east,north"
          },
          {
            "name": "polygon",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "lat,lon;lat,lon;...",
              "title": "Polygon"
            },
            "description": "lat,lon;lat,lon;..."
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End"
            }
          },
          {
            "name": "exclude_low",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "drop low-confidence detections",
              "default": true,
              "title": "Exclude Low"
            },
            "description": "drop low-confidence detections"
          },
          {
            "name": "vegetation_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "keep type = 0 (rows without type are kept)",
              "default": false,
              "title": "Vegetation Only"
            },
            "description": "keep type = 0 (rows without type are kept)"
          },
          {
            "name": "satellites",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "comma list of Terra,Aqua,SNPP,N20,N21 (raw values and map only)",
              "title": "Satellites"
            },
            "description": "comma list of Terra,Aqua,SNPP,N20,N21 (raw values and map only)"
          },
          {
            "name": "daynight",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(all|D|N)$",
              "description": "raw values and map only",
              "default": "all",
              "title": "Daynight"
            },
            "description": "raw values and map only"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
