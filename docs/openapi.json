                },
                {
                  "type": "null"
                }
              ],
              "description": "comma list of Terra,Aqua,SNPP,N20,N21 (raw values and map only)",
              "title": "Satellites"
            },
            "description": "comma list of Terra,Aqua,SNPP,N20,N21 (raw values and map only)"
