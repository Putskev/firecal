{
  "openapi": "3.1.0",
  "info": {
    "title": "FireCal API",
    "description": "Harmonized MODIS + VIIRS active fire hotspots (NASA FIRMS). This is a static copy of the documentation: run the backend locally (`uvicorn backend.main:app`) and open /docs to try the endpoints.",
    "version": "1.1"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/meta": {
      "get": {
        "summary": "Meta",
        "description": "Dataset span, counts per satellite, bounding box and the active harmonization method.",
        "operationId": "meta_api_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/timeseries": {
      "get": {
        "summary": "Timeseries",
        "description": "Raw and harmonized totals per period over the WHOLE data span (for calendar, anomalies, comparison).\nFields: modis_n, viirs_n, modis_frp, viirs_frp (raw) and modis_h_n, viirs_h_n, modis_h_frp,\nviirs_h_frp, harm_n, harm_frp (harmonized).",
        "operationId": "timeseries_api_timeseries_get",
        "parameters": [
          {
            "name": "granularity",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "month",
                "day"
              ],
              "type": "string",
              "default": "month",
              "title": "Granularity"
            }
          },
          {
            "name": "bbox",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "west,south,east,north",
              "title": "Bbox"
            },
            "description": "west,south,east,north"
          },
          {
            "name": "polygon",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "lat,lon;lat,lon;...",
              "title": "Polygon"
            },
            "description": "lat,lon;lat,lon;..."
          },
          {
            "name": "exclude_low",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Exclude Low"
            }
          },
          {
            "name": "vegetation_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Vegetation Only"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/heatmap": {
      "get": {
        "summary": "Heatmap",
        "description": "Hotspots aggregated to grid cells: cells = [[lat, lon, value], ...] (cell centres).\nPass the visible map area as bbox to keep responses small.",
        "operationId": "heatmap_api_heatmap_get",
        "parameters": [
          {
            "name": "view",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "harm",
                "modis",
                "viirs"
              ],
              "type": "string",
              "default": "harm",
              "title": "View"
            }
          },
          {
            "name": "metric",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "count",
                "frp"
              ],
              "type": "string",
              "default": "count",
              "title": "Metric"
            }
          },
          {
            "name": "res",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 5,
              "minimum": 0.01,
              "description": "grid cell size in degrees",
              "default": 0.25,
              "title": "Res"
            },
            "description": "grid cell size in degrees"
          },
          {
            "name": "bbox",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "west,south,east,north",
              "title": "Bbox"
            },
            "description": "west,south,east,north"
          },
          {
            "name": "polygon",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "lat,lon;lat,lon;...",
              "title": "Polygon"
            },
            "description": "lat,lon;lat,lon;..."
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End"
            }
          },
          {
            "name": "exclude_low",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Exclude Low"
            }
          },
          {
            "name": "vegetation_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Vegetation Only"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/hotspots.csv": {
      "get": {
        "summary": "Hotspots Csv",
        "description": "Download the filtered hotspots incl. harmonized weight and frp_h.",
        "operationId": "hotspots_csv_api_hotspots_csv_get",
        "parameters": [
          {
            "name": "view",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "harm",
                "modis",
                "viirs"
              ],
              "type": "string",
              "default": "harm",
              "title": "View"
            }
          },
          {
            "name": "bbox",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "west,south,east,north",
              "title": "Bbox"
            },
            "description": "west,south,east,north"
          },
          {
            "name": "polygon",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "lat,lon;lat,lon;...",
              "title": "Polygon"
            },
            "description": "lat,lon;lat,lon;..."
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End"
            }
          },
          {
            "name": "exclude_low",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Exclude Low"
            }
          },
          {
            "name": "vegetation_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Vegetation Only"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/reload": {
      "post": {
        "summary": "Reload",
        "description": "Rebuild (if inputs changed) and reload the data without restarting the server.\nProtected by the environment variable FIRECAL_RELOAD_TOKEN (disabled if unset).",
        "operationId": "reload_api_reload_post",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}