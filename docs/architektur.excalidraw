   "seed": 1190502837,
   "version": 1,
   "versionNonce": 1942810372,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1794661385043,
   "link": null,
   "locked": false,
   "text": "Echte Daten:  869.189 Hotspots, 8 Tage, weltweit\n  MODIS Terra + Aqua     75.923\n  VIIRS NOAA-20         399.584\n  VIIRS NOAA-21         393.682\n\nCSV 73 MB  →  Parquet 15 MB\nSummen: ~140.000 Zeilen statt 870.000\n\nBelastungstest 10,4 Mio. Hotspots:\n  API-Speicher 0,3 GB · Antworten 50–110 ms",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Echte Daten:  869.189 Hotspots, 8 Tage, weltweit\n  MODIS Terra + Aqua     75.923\n  VIIRS NOAA-20         399.584\n  VIIRS NOAA-21         393.682\n\nCSV 73 MB  →  Parquet 15 MB\nSummen: ~140.000 Zeilen statt 870.000\n\nBelastungstest 10,4 Mio. Hotspots:\n  API-Speicher 0,3 GB · Antworten 50–110 ms",
   "autoResize": true,
   "lineHeight": 1.25
  },
