  },
  {
   "id": "tex138",
   "type": "text",
   "x": 1650,
   "y": 700,
   "width": 483.6,
   "height": 375.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
