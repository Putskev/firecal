   "seed": 181242850,
   "version": 1,
   "versionNonce": 419812754,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1794661385043,
   "link": null,
   "locked": false,
   "text": "firecal/\n├─ index.html            Frontend (App)\n├─ api-docs.html         API-Doku für GitHub Pages\n├─ backend/\n│  ├─ main.py            FastAPI + DuckDB\n│  ├─ build.py           Build-Schritt\n│  ├─ harmonization.py   ← Methode einbauen (Weg A)\n│  ├─ data.py            Schema, Prüfung\n│  ├─ ingest.py          CSV → Parquet\n│  └─ paths.py           Ordner\n├─ data/\n│  ├─ incoming/          rohe CSVs (nicht im Git)\n│  ├─ raw/               Parquet, nicht harmonisiert\n│  ├─ harmonized/        ← fertige Tabelle (Weg B)\n│  └─ processed/         gebaut (nicht im Git)\n├─ content/methodology.md   ← Methodik-Text\n├─ docs/  AGENT_HANDOFF · PROJEKTSTAND · openapi\n├─ update.py · config.json  tägliches Update\n├─ .github/workflows/update.yml\n└─ Dockerfile · requirements.txt",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "firecal/\n├─ index.html            Frontend (App)\n├─ api-docs.html         API-Doku für GitHub Pages\n├─ backend/\n│  ├─ main.py            FastAPI + DuckDB\n│  ├─ build.py           Build-Schritt\n│  ├─ harmonization.py   ← Methode einbauen (Weg A)\n│  ├─ data.py            Schema, Prüfung\n│  ├─ ingest.py          CSV → Parquet\n│  └─ paths.py           Ordner\n├─ data/\n│  ├─ incoming/          rohe CSVs (nicht im Git)\n│  ├─ raw/               Parquet, nicht harmonisiert\n│  ├─ harmonized/        ← fertige Tabelle (Weg B)\n│  └─ processed/         gebaut (nicht im Git)\n├─ content/methodology.md   ← Methodik-Text\n├─ docs/  AGENT_HANDOFF · PROJEKTSTAND · openapi\n├─ update.py · config.json  tägliches Update\n├─ .github/workflows/update.yml\n└─ Dockerfile · requirements.txt",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "tex142",
   "type": "text",
   "x": 1650,
   "y": 1380,
   "width": 476.15999999999997,
   "height": 200.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
